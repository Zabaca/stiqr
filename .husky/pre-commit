echo "🔍 Running pre-commit checks..."

# TypeScript, on the app and the Worker (BLOCKING)
echo "📝 Checking TypeScript..."
if ! bun run --cwd apps/frontend typecheck; then
  echo "❌ TypeScript check failed! Please fix the type errors before committing."
  echo "💡 Run 'bun run typecheck' to see the errors."
  exit 1
fi

echo "✅ TypeScript check passed!"

# Biome lint check (NON-BLOCKING WARNING)
echo "🧹 Running Biome linting..."
if ! bun run --cwd apps/frontend lint:check >/dev/null 2>&1; then
  echo "⚠️ Biome linting issues found. Consider running 'bun run lint' to auto-fix."
  echo "📝 Lint issues won't block the commit, but TypeScript errors will."
fi

echo "✅ Pre-commit checks completed! TypeScript passed."

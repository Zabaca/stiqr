{
  "$schema": "node_modules/wrangler/config-schema.json",
  // stiqr: a Vite/React SPA plus two LLM proxy routes (worker/index.ts) that
  // replace the Netlify Functions. `bun run build` emits dist/.
  //
  // Lands on stiqr.<subdomain>.workers.dev. No custom domain yet, deliberately:
  // stiqr.zabaca.com is still served by Netlify, and the DNS flip is a separate
  // step once this URL has been compared against the live site.
  "name": "stiqr",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker owns the two proxy paths, so it has to run before the asset
    // layer answers. Everything it does not claim falls through to ASSETS.
    "run_worker_first": true,
    // A client-routed SPA: any unmatched path must return index.html rather than
    // a 404, or a deep link reloads into nothing.
    "not_found_handling": "single-page-application"
  }
}

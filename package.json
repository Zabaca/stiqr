{
  "name": "stiqr-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bun run --cwd apps/frontend dev",
    "build": "bun run --cwd apps/frontend build",
    "preview": "bun run --cwd apps/frontend preview",
    "typecheck": "bun run --cwd apps/frontend typecheck",
    "lint": "bun run --cwd apps/frontend lint",
    "lint:check": "bun run --cwd apps/frontend lint:check",
    "format": "bun run --cwd apps/frontend format",
    "format:check": "bun run --cwd apps/frontend format:check",
    "check": "bun run --cwd apps/frontend check",
    "test": "bun run --cwd apps/frontend test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

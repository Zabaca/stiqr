{
  "$schema": "node_modules/wrangler/config-schema.json",
  // stiqr: a Vite/React SPA plus two LLM proxy routes (worker/index.ts) that
  // replace the Netlify Functions. `bun run build` emits dist/.
  //
  // This is the live site: stiqr.zabaca.com resolves here as of the 2026-07-30
  // cutover, and it stays reachable at stiqr.<subdomain>.workers.dev for
  // comparing a build before it goes out.
  "name": "stiqr",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  // custom_domain makes wrangler own the DNS record, so the binding between site
  // and domain is this file rather than a dashboard setting. Rollback is in
  // docs/runbooks/dns-cutover-stiqr.md.
  "routes": [{ "pattern": "stiqr.zabaca.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker owns the two proxy paths, so it has to run before the asset
    // layer answers. Everything it does not claim falls through to ASSETS.
    "run_worker_first": true,
    // A client-routed SPA: any unmatched path must return index.html rather than
    // a 404, or a deep link reloads into nothing.
    "not_found_handling": "single-page-application"
  }
}
